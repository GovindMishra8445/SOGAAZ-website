# Copy to .env (local) — real values live only in .env / Render. Never commit secrets.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sogaaz?retryWrites=true&w=majority
JWT_SECRET=<random string, at least 32 characters>
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=strict
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="<strong password: 10+ chars, upper, lower, number, symbol>"
LOG_LEVEL=info
# Local only, if you get "querySrv ECONNREFUSED":
# DNS_SERVERS=8.8.8.8,1.1.1.1
